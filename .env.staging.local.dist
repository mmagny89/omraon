# Modele de secrets staging. cp .env.staging.local.dist .env.staging.local, puis renseigner.
CADDY_VERSION=2.11.9
TARGET=staging
# Suffixe des noms de conteneurs, du reseau et des volumes (section manifeste/nommage).
ENV=staging
USER_ID=1000
GROUP_ID=1000
HTTP_PORT=80
HTTPS_PORT=443
# Domaine servi (regle Host de Traefik).
DOMAINE=
