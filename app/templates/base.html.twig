<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}À l'ombre d'Omraon{% endblock %}</title>
  <style>
    :root { color-scheme: dark; --fond:#0b0e17; --carte:#141a2a; --bord:#2a3350; --texte:#e6e9f2; --doux:#9aa4c2; --accent:#7aa2ff; --erreur:#ff7a7a; --ok:#7aff9e; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--fond); color:var(--texte); font:16px/1.5 system-ui, sans-serif; }
    main { max-width: 56rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    h1 { font-size: 1.5rem; margin: 0 0 1rem; }
    a { color: var(--accent); }
    .carte { background:var(--carte); border:1px solid var(--bord); border-radius:.75rem; padding:1.25rem; }
    label { display:block; margin:.75rem 0 .25rem; color:var(--doux); }
    input[type=text], input[type=email], input[type=password] { width:100%; min-height:44px; padding:.5rem .75rem; background:var(--fond); color:var(--texte); border:1px solid var(--bord); border-radius:.5rem; font:inherit; }
    .check label { display:flex; gap:.6rem; align-items:center; min-height:44px; color:var(--texte); }
    .check input { width:1.25rem; height:1.25rem; }
    button, .btn { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:.5rem 1rem; background:var(--accent); color:#0b0e17; border:0; border-radius:.5rem; font:inherit; font-weight:600; cursor:pointer; text-decoration:none; }
    .btn.sec, button.sec { background:transparent; color:var(--texte); border:1px solid var(--bord); }
    .btn.danger, button.danger { background:var(--erreur); }
    .erreur { color:var(--erreur); } .succes { color:var(--ok); }
    .flash { padding:.75rem 1rem; border:1px solid var(--bord); border-radius:.5rem; margin-bottom:1rem; }
    .barre { display:flex; flex-wrap:wrap; gap:.5rem; justify-content:space-between; align-items:center; margin-bottom:1rem; }
    .table-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; } th, td { text-align:left; padding:.6rem .5rem; border-bottom:1px solid var(--bord); vertical-align:middle; }
    .actions { display:flex; gap:.5rem; flex-wrap:wrap; } .actions form { margin:0; }
    nav.principale { display:flex; flex-wrap:wrap; gap:.25rem .5rem; margin-bottom:1.25rem; padding-bottom:.75rem; border-bottom:1px solid var(--bord); }
    nav.principale a { display:inline-flex; align-items:center; min-height:44px; padding:0 .6rem; border-radius:.5rem; text-decoration:none; }
    nav.principale a[aria-current] { background:var(--carte); border:1px solid var(--bord); }
    nav.principale .droite { margin-left:auto; }
    dl.fiche { display:grid; grid-template-columns:minmax(8rem,14rem) 1fr; gap:.4rem 1rem; margin:0; } dl.fiche dt { color:var(--doux); } dl.fiche dd { margin:0; }
    .badge { display:inline-block; padding:.05rem .5rem; border:1px solid var(--bord); border-radius:1rem; font-size:.8rem; color:var(--doux); }
    ul.liste { list-style:none; margin:0; padding:0; } ul.liste li { padding:.5rem 0; border-bottom:1px solid var(--bord); }
    h2 { font-size:1.15rem; margin:1.5rem 0 .5rem; }
    .form-error { color:var(--erreur); font-size:.9rem; }
  </style>
</head>
<body>
  <main>
    {% if app.user %}
    {% set route = app.request.attributes.get('_route') %}
    <nav class="principale" aria-label="Navigation principale">
      <a href="{{ path('app_accueil') }}">Vue du système</a>
      <a href="{{ path('fiches_astres') }}"{% if route starts with 'fiches_astre' %} aria-current="page"{% endif %}>Astres</a>
      <a href="{{ path('fiches_sites') }}"{% if route starts with 'fiches_site' %} aria-current="page"{% endif %}>Sites</a>
      <a href="{{ path('fiches_personnages') }}"{% if route starts with 'fiches_personnage' %} aria-current="page"{% endif %}>Personnages</a>
      <a href="{{ path('fiches_scenes') }}"{% if route starts with 'fiches_scene' %} aria-current="page"{% endif %}>Scènes</a>
      <a href="{{ path('fiches_lexique') }}"{% if route == 'fiches_lexique' %} aria-current="page"{% endif %}>Lexique</a>
      <a href="{{ path('fiches_chronologie') }}"{% if route == 'fiches_chronologie' %} aria-current="page"{% endif %}>Chronologie</a>
      {% if is_granted('ROLE_ADMIN') %}<a class="droite" href="{{ path('admin_donnees') }}">Valeurs</a><a href="{{ path('admin_utilisateurs') }}">Comptes</a>{% endif %}
      <a{% if not is_granted('ROLE_ADMIN') %} class="droite"{% endif %} href="{{ path('app_logout') }}">Déconnexion</a>
    </nav>
    {% endif %}
    {% for type, messages in app.flashes %}{% for m in messages %}<p class="flash {{ type }}" role="status">{{ m }}</p>{% endfor %}{% endfor %}
    {% block body %}{% endblock %}
  </main>
</body>
</html>
