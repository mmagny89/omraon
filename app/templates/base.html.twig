<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <meta name="color-scheme" content="dark">
  <title>{% block title %}À l'ombre d'Omraon{% endblock %}</title>
  <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
  <script src="{{ asset('app.js') }}" defer></script>
  {% block scripts %}{% endblock %}
</head>
<body class="flex min-h-screen flex-col bg-fond font-sans text-texte antialiased">
  <a href="#contenu" class="sr-only z-50 rounded bg-accent px-4 py-2 font-semibold text-fond focus:not-sr-only focus:fixed focus:left-4 focus:top-4">Aller au contenu</a>

  {% if app.user %}
  {% set route = app.request.attributes.get('_route') %}
  {% set liens = [
    {texte: 'Astres', route: 'fiches_astres', prefixe: 'fiches_astre'},
    {texte: 'Sites', route: 'fiches_sites', prefixe: 'fiches_site'},
    {texte: 'Personnages', route: 'fiches_personnages', prefixe: 'fiches_personnage'},
    {texte: 'Scènes', route: 'fiches_scenes', prefixe: 'fiches_scene'},
    {texte: 'Lexique', route: 'fiches_lexique', prefixe: 'fiches_lexique'},
    {texte: 'Chronologie', route: 'fiches_chronologie', prefixe: 'fiches_chronologie'},
  ] %}
  <header class="sticky top-0 z-40 border-b border-ligne bg-fond/90 backdrop-blur">
    <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-4 gap-y-1 px-4 sm:px-6">
      <a href="{{ path('app_accueil') }}" class="flex min-h-11 items-center gap-2 font-semibold hover:text-accent">
        <span aria-hidden="true" class="text-accent">✦</span><span>À l'ombre d'Omraon</span>
      </a>
      <a href="{{ path('app_accueil') }}" class="ml-auto inline-flex min-h-11 items-center rounded-lg bg-accent px-4 text-sm font-semibold text-fond hover:brightness-110 sm:order-last sm:ml-0">Vue du système</a>
      <nav aria-label="Navigation principale" class="-mx-4 flex w-[calc(100%+2rem)] gap-1 overflow-x-auto px-4 sm:mx-0 sm:w-auto sm:flex-1 sm:px-0">
        {% for l in liens %}
          <a href="{{ path(l.route) }}" {% if route starts with l.prefixe %}aria-current="page"{% endif %}
             class="inline-flex min-h-11 shrink-0 items-center rounded-lg px-3 text-sm hover:bg-carte hover:text-accent aria-[current=page]:bg-carte aria-[current=page]:font-semibold aria-[current=page]:text-accent">{{ l.texte }}</a>
        {% endfor %}
      </nav>
      <details class="relative">
        <summary class="inline-flex min-h-11 list-none items-center gap-2 rounded-lg px-3 text-sm hover:bg-carte [&::-webkit-details-marker]:hidden">
          <span class="max-w-32 truncate">{{ app.user.nom }}</span><span aria-hidden="true">▾</span>
        </summary>
        <div class="absolute right-0 z-50 mt-1 w-56 rounded-xl border border-ligne bg-carte p-2 shadow-xl">
          <p class="px-3 py-2 text-xs text-doux">{{ app.user.userIdentifier }}<br>{{ is_granted('ROLE_ADMIN') ? 'Administrateur' : 'Lecteur' }}</p>
          {% if is_granted('ROLE_ADMIN') %}
            <a class="flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-fond hover:text-accent" href="{{ path('admin_donnees') }}">Valeurs par défaut</a>
            <a class="flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-fond hover:text-accent" href="{{ path('admin_utilisateurs') }}">Comptes</a>
          {% endif %}
          <a class="flex min-h-11 items-center rounded-lg px-3 text-sm hover:bg-fond hover:text-accent" href="{{ logout_path() }}">Déconnexion</a>
        </div>
      </details>
    </div>
  </header>
  {% endif %}

  <main id="contenu" class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">
    {% for type, messages in app.flashes %}{% for m in messages %}
      <p role="status" class="mb-4 rounded-lg border px-4 py-3 text-sm {{ type == 'erreur' ? 'border-danger/50 bg-danger/10 text-danger' : 'border-ok/50 bg-ok/10 text-ok' }}">{{ m }}</p>
    {% endfor %}{% endfor %}
    {% block body %}{% endblock %}
  </main>

  <footer class="border-t border-ligne px-4 py-4 text-center text-xs text-doux">
    {% if app.user %}{% import '_c.html.twig' as c %}{{ c.legende() }}{% endif %}
    <p class="mt-2">À l'ombre d'Omraon — accès réservé</p>
  </footer>
</body>
</html>
