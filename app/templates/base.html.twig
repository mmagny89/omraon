<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>{% block title %}À l'ombre d'Omraon{% endblock %}</title>
  <style>
    :root { color-scheme: dark; --fond:#0b0e17; --carte:#141a2a; --bord:#2a3350; --texte:#e6e9f2; --doux:#9aa4c2; --accent:#7aa2ff; --erreur:#ff7a7a; --ok:#7aff9e; }
    * { box-sizing: border-box; }
    body { margin:0; background:var(--fond); color:var(--texte); font:16px/1.5 system-ui, sans-serif; }
    main { max-width: 56rem; margin: 0 auto; padding: 1.5rem 1rem 3rem; }
    h1 { font-size: 1.5rem; margin: 0 0 1rem; }
    a { color: var(--accent); }
    .carte { background:var(--carte); border:1px solid var(--bord); border-radius:.75rem; padding:1.25rem; }
    label { display:block; margin:.75rem 0 .25rem; color:var(--doux); }
    input[type=text], input[type=email], input[type=password] { width:100%; min-height:44px; padding:.5rem .75rem; background:var(--fond); color:var(--texte); border:1px solid var(--bord); border-radius:.5rem; font:inherit; }
    .check label { display:flex; gap:.6rem; align-items:center; min-height:44px; color:var(--texte); }
    .check input { width:1.25rem; height:1.25rem; }
    button, .btn { display:inline-flex; align-items:center; justify-content:center; min-height:44px; padding:.5rem 1rem; background:var(--accent); color:#0b0e17; border:0; border-radius:.5rem; font:inherit; font-weight:600; cursor:pointer; text-decoration:none; }
    .btn.sec, button.sec { background:transparent; color:var(--texte); border:1px solid var(--bord); }
    .btn.danger, button.danger { background:var(--erreur); }
    .erreur { color:var(--erreur); } .succes { color:var(--ok); }
    .flash { padding:.75rem 1rem; border:1px solid var(--bord); border-radius:.5rem; margin-bottom:1rem; }
    .barre { display:flex; flex-wrap:wrap; gap:.5rem; justify-content:space-between; align-items:center; margin-bottom:1rem; }
    .table-wrap { overflow-x:auto; }
    table { width:100%; border-collapse:collapse; } th, td { text-align:left; padding:.6rem .5rem; border-bottom:1px solid var(--bord); vertical-align:middle; }
    .actions { display:flex; gap:.5rem; flex-wrap:wrap; } .actions form { margin:0; }
    .form-error { color:var(--erreur); font-size:.9rem; }
  </style>
</head>
<body>
  <main>
    {% for type, messages in app.flashes %}{% for m in messages %}<p class="flash {{ type }}" role="status">{{ m }}</p>{% endfor %}{% endfor %}
    {% block body %}{% endblock %}
  </main>
</body>
</html>
