{% extends 'base.html.twig' %}
{% import '_c.html.twig' as c %}
{% block title %}Valeurs par défaut — À l'ombre d'Omraon{% endblock %}
{% block body %}
{{ c.fil([{texte: 'Accueil', url: path('app_accueil')}, {texte: 'Valeurs par défaut'}]) }}
{{ c.entete('Valeurs par défaut', 'Une section modifiée remplace le canon pour tous les comptes. Les lecteurs simulent à partir de ces valeurs sans les changer.') }}
<div class="space-y-8">
{% for jeu in jeux %}
  <section class="rounded-xl border border-ligne bg-carte p-6" aria-labelledby="j-{{ jeu.cle }}">
    <h2 id="j-{{ jeu.cle }}" class="mb-5 text-sm font-semibold uppercase tracking-wider text-accent">{{ jeu.libelle }}</h2>
    <ul class="divide-y divide-ligne">
    {% for s in jeu.sections %}
      <li class="flex flex-wrap items-center justify-between gap-3 py-2">
        <div><code class="rounded bg-fond px-1.5 py-0.5 text-sm">{{ s.nom }}</code>
          <span class="ml-2">{% if s.surcharge %}{{ c.badge('Modifiée par ' ~ s.surcharge.modifiePar ~ ' le ' ~ s.surcharge.modifieLe|date('d/m/Y H:i'), 'accent') }}{% else %}{{ c.badge('Canon') }}{% endif %}</span></div>
        <div class="flex gap-2">
          <a class="inline-flex min-h-11 items-center rounded-lg border border-ligne px-3 text-sm hover:border-accent hover:text-accent" href="{{ path('admin_donnees_modifier', {jeu: jeu.cle, section: s.nom}) }}">Modifier</a>
          {% if s.surcharge %}
          <form method="post" action="{{ path('admin_donnees_reinitialiser', {jeu: jeu.cle, section: s.nom}) }}" onsubmit="return confirm('Remettre cette section au canon ?')">
            <input type="hidden" name="_token" value="{{ csrf_token('reinit' ~ jeu.cle ~ s.nom) }}"><button class="min-h-11 rounded-lg border border-ligne px-3 text-sm hover:border-accent hover:text-accent" type="submit">Réinitialiser</button>
          </form>{% endif %}
        </div>
      </li>
    {% endfor %}
    </ul>
  </section>
{% endfor %}
</div>
{% endblock %}
