{% extends 'base.html.twig' %}
{% block title %}{{ section }} — À l'ombre d'Omraon{% endblock %}
{% block body %}
<div class="barre"><h1>{{ section }} <small style="color:var(--doux);font-size:.9rem">({{ jeu }})</small></h1><a class="btn sec" href="{{ path('admin_donnees') }}">Retour</a></div>
<div class="carte">
  {% if erreur %}<p class="erreur" role="alert">{{ erreur }}</p>{% endif %}
  <form method="post">
    <label for="valeur">Valeur (JSON)</label>
    <textarea id="valeur" name="valeur" rows="28" spellcheck="false" style="width:100%;background:var(--fond);color:var(--texte);border:1px solid var(--bord);border-radius:.5rem;padding:.75rem;font:.85rem/1.4 ui-monospace,Menlo,monospace">{{ texte }}</textarea>
    <input type="hidden" name="_token" value="{{ csrf_token('donnees' ~ jeu ~ section) }}">
    <p><button type="submit">Enregistrer</button></p>
  </form>
</div>
{% endblock %}
