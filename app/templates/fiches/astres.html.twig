{% extends 'base.html.twig' %}
{% import '_c.html.twig' as c %}
{% block title %}Astres — À l'ombre d'Omraon{% endblock %}
{% block body %}
{{ c.fil([{texte: 'Accueil', url: path('app_accueil')}, {texte: 'Astres'}]) }}
{{ c.entete('Astres', 'L\'étoile, les planètes, leurs lunes et les deux ceintures. Chaque fiche donne les températures des faces éclairée et sombre.') }}
{{ c.filtre('liste-astres', 'Filtrer les astres', 'Rechercher un astre, une lune…') }}
<div id="liste-astres" class="space-y-8">
  {% for titre, types in {'Étoile et ceintures': ['Étoile', 'Ceinture d\'astéroïdes', 'Ceinture froide'], 'Planètes et lunes': ['Planète tellurique', 'Planète gazeuse', 'Lune']} %}
  <section data-groupe aria-labelledby="g-{{ loop.index }}">
    <h2 id="g-{{ loop.index }}" class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">{{ titre }}</h2>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {% for a in astres|filter(x => x.type in types) %}
      <li data-filtrable>
        <a href="{{ path('fiches_astre', {id: a.id}) }}" class="flex h-full flex-col gap-2 rounded-xl border border-ligne bg-carte p-4 transition hover:border-accent/60 hover:bg-carte/70 motion-reduce:transition-none">
          <span class="flex items-center gap-2">
            <span aria-hidden="true" class="size-3 shrink-0 rounded-full ring-1 ring-white/20" style="background: {{ a.couleur ?? '#8d9bb8' }}"></span>
            <span class="text-lg font-semibold">{{ a.nom }}</span>
          </span>
          <span class="flex flex-wrap gap-2">{{ c.badge(a.type, a.type == 'Étoile' ? 'accent' : 'neutre') }}{% if a.parent %}{{ c.badge('de ' ~ a.parent) }}{% endif %}</span>
          <span class="line-clamp-3 text-sm text-doux">{{ a.role }}</span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
{% endblock %}
