{# Téléversement d'une illustration (admin) : remplace l'illustration générée, que la suppression rétablit. #}
<section aria-labelledby="illu-admin" class="rounded-xl border border-ligne bg-carte p-5">
  <h2 id="illu-admin" class="mb-3 text-sm font-semibold uppercase tracking-wider text-accent">Illustration (administration)</h2>
  <p class="mb-3 text-sm text-doux">{{ televersee ? 'Une illustration téléversée remplace l\'illustration générée.' : 'L\'illustration affichée est générée depuis les données.' }} PNG, JPEG ou WebP, 2 Mo au plus.</p>
  <form method="post" action="{{ path('admin_illustration_televerser', {type: type, cle: cle}) }}" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
    <label for="illu-fichier" class="sr-only">Fichier image</label>
    <input id="illu-fichier" type="file" name="image" accept="image/png,image/jpeg,image/webp" required class="min-h-11 max-w-full rounded-lg border border-ligne bg-fond px-3 py-2 text-sm file:mr-3 file:rounded file:border-0 file:bg-accent file:px-3 file:py-1 file:font-semibold file:text-fond">
    <input type="hidden" name="_token" value="{{ csrf_token('illustration' ~ type ~ cle) }}">
    <button type="submit" class="min-h-11 rounded-lg bg-accent px-4 text-sm font-semibold text-fond hover:brightness-110">Téléverser</button>
  </form>
  {% if televersee %}
  <form method="post" action="{{ path('admin_illustration_supprimer', {type: type, cle: cle}) }}" class="mt-3" onsubmit="return confirm('Retirer l\'illustration téléversée ?')">
    <input type="hidden" name="_token" value="{{ csrf_token('illustration' ~ type ~ cle) }}">
    <button type="submit" class="min-h-11 rounded-lg border border-danger/50 px-4 text-sm text-danger hover:bg-danger/10">Retirer l'illustration téléversée</button>
  </form>
  {% endif %}
</section>
