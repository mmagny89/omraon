# Site statique. CADDY_GLOBAL_OPTIONS est un point d'extension : les overrides
# d'environnement l'alimentent sans jamais avoir a modifier ce fichier.
{
	{$CADDY_GLOBAL_OPTIONS}

	# Metriques Prometheus natives de Caddy (section reseau/observabilite),
	# en option GLOBALE : la forme `servers { metrics }` est depreciee.
	metrics

	# Pas d'API d'administration : un site statique n'a rien a recharger a chaud.
	admin off
}

{$SERVER_NAME:localhost} {
	root * /srv
	encode zstd gzip
	log

	# En-tetes de securite, sur toutes les reponses. defer : appliques aussi
	# aux reponses d'erreur, ou Caddy remettrait Server. Pas de HSTS ici : le TLS
	# est termine par le proxy, et un HSTS servi en developpement sur localhost
	# s'imposerait a tous les projets locaux. La Content-Security-Policy depend
	# des ressources du projet : a poser dans le Caddyfile du projet.
	header {
		defer
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
		-X-Powered-By
	}

	# durcissement:fichiers-sensibles — php_server sert tout le docroot ; Caddy
	# ne lit pas les .htaccess. Dotfiles (sauf /.well-known/) et fichiers de
	# sauvegarde, de journal, de dependances : 404, comme s'ils n'existaient pas.
	@fichiers_caches {
		path_regexp fichiers_caches (^|/)\.
		not path /.well-known/*
	}
	@fichiers_sensibles path_regexp fichiers_sensibles (?i)(\.(sql|bak|old|orig|save|swp|log|dist|lock)|~|(^|/)(composer\.json|package(-lock)?\.json|Dockerfile|compose[^/]*\.ya?ml))$
	handle @fichiers_caches {
		respond 404
	}
	handle @fichiers_sensibles {
		respond 404
	}


	route {
		respond /health 200
		file_server
	}
}

# Ecoute interne : metriques et sonde du healthcheck (sections reseau/ports et
# reseau/observabilite). JAMAIS publiee sur l'hote.
:2020 {
	route {
		respond /health 200
		metrics
	}
}
