# Variables Docker Compose — lues uniquement par Docker Compose
# (conventions, section env/trois-niveaux). Committe, sans secret. Genere par
# .claude/scripts/setup-symfony.sh le 2026-11-14.
#
# En staging et production, remplace (pas complete) par --env-file
# .env.staging.local / .env.prod.local, qui portent toutes les cles.

COMPOSE_FILE=compose.yml:compose.dev.yml

# Suffixe des noms visibles — conteneurs, reseau, volumes (section manifeste/nommage).
# Il permet a la PPD et a la production de cohabiter sur un meme hote
# sans partager ni conteneur ni volume. Les fichiers de secrets le
# redefinissent a staging et prod.
ENV=dev

# Versions d'images — verifiees aupres des registres le 2026-11-14.
PHP_VERSION=8.5.12
FRANKENPHP_VERSION=1.13.5
PHP_EXTENSION_INSTALLER_VERSION=2.13.2
POSTGRES_VERSION=18
# Attrapeur d'emails de developpement (section env/emails).
MAILPIT_VERSION=1.33.1

# Stage du Dockerfile PHP construit par un "docker compose -f compose.yml
# build" autonome ; les overrides figent target:/image: en dur.
TARGET=dev

# UID/GID de l'hote (section manifeste/uid-gid) — machine de generation.
USER_ID=501
GROUP_ID=20

# Xdebug — jamais fige au build (section env/directives-php).
XDEBUG_MODE=off

# Ports (section reseau/ports) — valeurs fixes, jamais deduites de l'hote.
HTTP_PORT=80
HTTPS_PORT=443
HTTP3_PORT=443
POSTGRES_PORT=5432
# Interface web de l'attrapeur d'emails. Son port SMTP (1025) reste interne.
MAILPIT_PORT=8025

# Emails (section env/emails). En developpement tout part vers Mailpit, qui les retient
# et les affiche ; rien ne quitte la machine. Staging et production portent leur
# propre valeur dans leur fichier de secrets, ce fichier n'y etant pas lu.
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM=noreply@localhost

# Proxies de confiance (section reseau/ports). Vide en developpement : rien ne s'interpose,
# et faire confiance a des en-tetes que personne ne pose les rendrait
# falsifiables. En staging et en production : private_ranges.
SYMFONY_TRUSTED_PROXIES=

# Mise a jour de schema au demarrage (section env/schema) — active en dev.
RUN_MIGRATIONS=1

# PostgreSQL — developpement uniquement.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=!ChangeMe!
